# Copy to ".env" for local dev (never commit .env).

# --- Keep It In The Family form → Google Sheet ---
#
# Use TWO different repo secrets — do not swap them:
#   VITE_KITF_SUBMIT_URL   = long https://script.google.com/macros/s/…/exec from Deploy
#   VITE_KITF_SUBMIT_SECRET = short shared password (optional), NOT the URL above
#
# In Google Apps Script: Deploy → New deployment
#   → Select type: **Web app** (not API executable / add-on / library)
#   → Execute as: **Me**
#   → Who has access: **Anyone**
#   → Deploy → copy the URL ending in /exec
#
VITE_KITF_SUBMIT_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec

# Optional; must match SCRIPT_SECRET in Apps Script if you set one there.
VITE_KITF_SUBMIT_SECRET=

# Support Us page — Yoco / PayFast / hosted donation URL (optional).
# VITE_DONATION_LINK=
# Volunteer Google Form or sign-up URL (optional; else email is used).
# VITE_VOLUNTEER_SIGNUP_URL=

# --- Property Partnerships enquiry → Google Sheet (Apps Script web app) ---
# Same pattern as KITF: URL ends in /exec; optional secret must NOT be pasted into the URL secret.
# GitHub Actions: set repo secret VITE_PROPERTY_ENQUIRY_SUBMIT_URL to this deployed web app URL.
# Full setup: docs/PROPERTY_ENQUIRY_SHEET_SETUP.md
#
# Production `/exec` URL (uncomment in `.env` locally if you want the form in dev):
# VITE_PROPERTY_ENQUIRY_SUBMIT_URL=https://script.google.com/macros/s/AKfycby7zEB-i2_m12N8NwbpwTbO5jR0VVZkwBDE3KDBsEOf3ak9hjYLBW975seX7KwUk2-o/exec
# VITE_PROPERTY_ENQUIRY_SECRET=

# --- Opportunities forms → Google Sheets (Apps Script web apps) ---
# Sheet tabs: "Job Seekers" and "Opportunities" — see comments in src/config.ts for column mapping.
# VITE_LOOKING_FOR_WORK_SUBMIT_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec
# VITE_LOOKING_FOR_WORK_SUBMIT_SECRET=
# VITE_OFFERING_WORK_SUBMIT_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec
# VITE_OFFERING_WORK_SUBMIT_SECRET=

# Instagram (optional)
# VITE_INSTAGRAM_WIDGET_URL=
